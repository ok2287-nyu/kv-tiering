# Copy to .env and adjust. No secrets are required: Qwen2.5 is ungated.

# Model to load (any Hugging Face causal LM with grouped-query attention)
KVT_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Put the Hugging Face cache on scratch, not in your home quota
HF_HOME=/scratch/$USER/hf_cache

# 1 = run the test suite against the real model instead of the tiny random one
KVT_REAL_MODEL=0

# Optional; only needed for gated models
# HF_TOKEN=
